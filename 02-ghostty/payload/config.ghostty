# Ghostty 1.3.1 — config de máximo desempenho (multi-abas + agentes de codificação)
# Local: ~/.config/ghostty/config.ghostty
# Aplicar SEM fechar a instância ativa: salvar + Ctrl+Shift+, (reload_config).

# --- Janela / processo ----------------------------------------------------
gtk-single-instance = true
# Janela nova entra no MESMO processo (custo de janela extra ~poucos MB, como o
# kitty --single-instance). O .desktop do PPA já passa --gtk-single-instance=true;
# aqui fica explícito para `ghostty` puro via CLI. Caveat: janela nova NÃO relê
# o arquivo de config (herda a do processo) — reload manual depois de editar.

window-theme = ghostty
# Chrome escuro próprio, independente do tema do sistema — casa com o fundo Dracula.

# --- Fonte (paridade visual com o kitty) ----------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 12
font-synthetic-style = false
# A fonte instalada tem Regular/Bold/Italic/Bold-Italic reais (fc-list) → a síntese
# nunca é usada; o valor só documenta intenção (custo zero; ganharia em fonte incompleta).

# --- Tema / cores (Dracula; estático, custo zero de composição)
background-opacity = 1.0
# Sem composição alfa por frame — mesmo rationale do kitty (caso wezterm-gui a 936%
# de CPU em 2026-06-28, caminho de apresentação ruim com transparência).
background-blur = 0
# Chave real (0 = intensidade zero = false), mas no-op nesta máquina: só age com
# background-opacity < 1 e em macOS/KDE. Mantida explícita para não ser ligada
# por engano junto com transparência dinâmica.

theme = dracula
# Tema Dracula (port oficial dracula/ghostty; arquivo: ~/.config/ghostty/themes/dracula).

# --- Scrollback (streaming longo de agente) --------------------------------
scrollback-limit = 100000000
# 100 MB por superfície. UNIDADE = BYTES (não linhas!); default do 1.3.x é 10.000.000.
# Alocação LAZY: só consome o que foi impresso de verdade. O "1000000" do relatório
# (1 MB) é MENOR que o default e truncaria sessão longa de agente — conta na seção
# seguinte.

# --- Abas / splits -----------------------------------------------------------
gtk-titlebar-style = tabs
# Abas no título (CSD do GTK) — mais área útil para o conteúdo. Alternativa: tabs-inline.
confirm-close-surface = true
# Pede confirmação ao fechar superfície com processo rodando (paridade com o
# confirm_os_window_close -1 do kitty) — protege aba com agente/build.
# Splits: nativos desde o 1.2.0, sem config necessária — keybinds na seção abaixo.

# --- Keybinds customizados (2026-08-14) ---------------------------------------
# ctrl+t = nova aba | ctrl+r = renomear aba | ctrl+w = fechar terminal
# ctrl+setas = novo split na direção da seta (ctrl+alt+setas segue = navegar).
# ctrl+8/4/2/6 = redimensionar a divisória nas 4 direções (8=cima, 4=esq,
# 2=baixo, 6=dir — "expand/collapse" completo). Zoom da FONTE segue em
# ctrl+= / ctrl+- (defaults do Ghostty).
# ⚠️ paridade: espelhar no GHOSTTY_PAYLOAD (max-perf-agentes.sh) e na doc, senão
# o `apply` REVERTE estes binds.
keybind = ctrl+t=new_tab
keybind = ctrl+r=prompt_tab_title
keybind = ctrl+arrow_left=new_split:left
keybind = ctrl+arrow_right=new_split:right
keybind = ctrl+arrow_up=new_split:up
keybind = ctrl+arrow_down=new_split:down
keybind = ctrl+w=close_surface
keybind = ctrl+8=resize_split:up,10
keybind = ctrl+4=resize_split:left,10
keybind = ctrl+2=resize_split:down,10
keybind = ctrl+6=resize_split:right,10

# --- Shell / interação -------------------------------------------------------
shell-integration = zsh
cursor-click-to-move = true
# 1.3: clicar num ponto da linha de prompt move o cursor (exige OSC 133, via
# shell-integration).
cursor-style-blink = false
# Cursor fixo: não acorda o loop de redraw ~2×/s à toa (bateria). A chave correta é
# cursor-style-blink — "cursor-blink" NÃO existe no 1.3.1 (unknown field).

window-padding-x = 6
window-padding-y = 6
# Paridade com o kitty (window_padding_width 6).
