#!/usr/bin/env bash
# deepeco — estamos na janela de economia da API DeepSeek agora?
#
#   deepeco            banner MUNDO DEV + status + tabela de horários/valores
#   deepeco --short    status + tabela, sem o banner (é o que o `deepclaude`
#                      imprime ao subir — ele já mostra o banner dele)
#
# REGIME (fontes oficiais DeepSeek, reconferido em 17/08/2026 — JÁ EM VIGOR
# desde 16/08/2026 16:00 UTC): os horários de PICO custam 2× e TODO o resto
# do dia (17h) é economia (metade do pico). Os picos são definidos em UTC pelo relógio do
# SERVIDOR da API — este script converte para o SEU fuso automaticamente
# (via `date +%z`), então a saída bate com o UTC-3 do Brasil e com qualquer
# outro fuso.
#
# REGRA NOVA DA DEEPSEEK (a partir de 2026-08-23 00:00 de Pequim =
# 2026-08-22 16:00 UTC): nos FINS DE SEMANA do fuso de PEQUIM (sáb e dom,
# UTC+8 fixo, sem DST) o dia inteiro é cobrado na tarifa de ECONOMIA — os
# picos NÃO valem. Dias úteis (seg a sex, Pequim) seguem o regime acima.
# Cobranças anteriores à vigência seguem a regra antiga. Default: ON (1) —
# um conf antigo sem as chaves ECO_FDS_* aplica a regra nova; desligue com
# ECO_FDS_ECO_DIA_INTEIRO="0" no conf.
#
# Janela e preços vivem em ~/.config/aula-dev/deepeco.conf — quando a
# DeepSeek mudar a política, atualize lá, sem tocar neste script.
set -euo pipefail

# ── Banner MUNDO DEV (desligue com MUNDO_DEV_BANNER=0) ──────────────────────
_mundo_dev_banner() {
  [ "${MUNDO_DEV_BANNER:-1}" = "0" ] && return 0
  cat <<'MDB'
┏┳┓╻ ╻┏┓╻╺┳┓┏━┓   ╺┳┓┏━╸╻ ╻
┃┃┃┃ ┃┃┗┫ ┃┃┃ ┃    ┃┃┣╸ ┃┏┛
╹ ╹┗━┛╹ ╹╺┻┛┗━┛   ╺┻┛┗━╸┗┛
MDB
}

# ── Defaults (sobrescritos pelo deepeco.conf) ────────────────────────────────
ECO_ATIVO=1                              # 0 = sem variação de preço por horário
ECO_PICOS_UTC="01:00-04:00 06:00-10:00"  # janelas de PICO em UTC, em ORDEM CRONOLÓGICA
ECO_DESCONTO_LABEL="economia = metade do preço de pico (50% off, todos os modelos)"
# Tarifas por 1M tokens (cache hit / cache miss / output) — células da tabela.
# Manter ASCII puro: a largura das colunas é calculada por contagem de chars.
ECO_PRECO_FLASH_ECONOMIA='$0.007 / $0.22 / $0.66'
ECO_PRECO_PRO_ECONOMIA='$0.022 / $0.66 / $1.98'
ECO_PRECO_FLASH_PICO='$0.014 / $0.44 / $1.32'
ECO_PRECO_PRO_PICO='$0.044 / $1.32 / $3.96'
ECO_FONTE="https://api-docs.deepseek.com/quick_start/pricing/"

CONF="${DEEPECO_CONF:-$HOME/.config/aula-dev/deepeco.conf}"
# `tr -d '\r'` ANTES do source: um clone no Windows com core.autocrlf=true
# entrega o conf com CRLF, e até uma linha em branco com \r viraria "comando
# $'\r' não encontrado" e mataria o script (set -e). O <() é bash 3.2-ok.
# shellcheck disable=SC1090
[ -r "$CONF" ] && . <(tr -d '\r' < "$CONF")

# ── Defaults da regra de fim de semana ───────────────────────────────────────
# Sem chaves no conf (conf antigo, instalado antes desta mudança), a regra nova
# vale por padrão (ECO_FDS_ECO_DIA_INTEIRO ON; vigência 2026-08-23 00:00 Pequim).
# "0" desliga. O valor do conf (se existir) sobrescreve estes defaults.
: "${ECO_FDS_ECO_DIA_INTEIRO:=1}"
: "${ECO_FDS_VIGENCIA:=2026-08-23}"

# ── Relógio ──────────────────────────────────────────────────────────────────
_min()  { local h m; h="${1%%:*}"; m="${1##*:}"; printf '%d' "$(( 10#$h * 60 + 10#$m ))"; }
_hhmm() { printf '%02d:%02d' "$(( $1 / 60 ))" "$(( $1 % 60 ))"; }
_dur()  { if [ "$1" -ge 60 ]; then printf '%dh%02d' "$(( $1 / 60 ))" "$(( $1 % 60 ))"; else printf '%d min' "$1"; fi; }

# dias desde a época (1970-01-01) a partir de uma data civil — algoritmo de
# Howard Hinnant (date_algorithms.html). Portátil (GNU/BSD/Git Bash): só
# aritmética inteira, sem `date -d` GNU-only. days_from_civil(2026-08-23)=20688.
_days_from_civil() {
  local y=$1 m=$2 d=$3 yr era yoe doy doe
  [ "$m" -le 2 ] && yr=$((y-1)) || yr=$y
  if   [ "$yr" -ge 0 ]; then era=$(( yr / 400 )); else era=$(( (yr-399)/400 )); fi
  yoe=$(( yr - era*400 ))                                   # [0, 399]
  [ "$m" -gt 2 ] && m=$((m-3)) || m=$((m+9))
  doy=$(( (153*m + 2)/5 + d - 1 ))                          # [0, 365]
  doe=$(( yoe*365 + yoe/4 - yoe/100 + doy ))                # [0, 146096]
  printf '%d' "$(( era*146097 + doe - 719468 ))"
}

# UMA leitura só do relógio (duas chamadas na virada de hora dariam −60 min).
# DEEPECO_NOW="YYYY-MM-DD HH:MM" (UTC) substitui o relógio — hook de teste e
# preview (ver `deepeco --help`): testa um timestamp ou "como estará amanhã".
if [ -n "${DEEPECO_NOW:-}" ]; then
  now_day_s="${DEEPECO_NOW% *}"
  now_hm="${DEEPECO_NOW#* }"
else
  now_day_s="$(date -u +%F)"
  now_hm="$(date -u +%H:%M)"
fi
now_utc=$(_min "$now_hm")                                    # minuto do dia (UTC)
now_y=$(( 10#${now_day_s%%-*} ))
now_ymd="${now_day_s#*-}"                                   # MM-DD
now_m=$(( 10#${now_ymd%%-*} ))
now_d=$(( 10#${now_ymd##*-} ))
now_day_abs=$(_days_from_civil "$now_y" "$now_m" "$now_d")
now_abs=$(( now_day_abs*1440 + now_utc ))                    # agora absoluto (min UTC)

# ── Fuso de Pequim (UTC+8 fixo, sem DST) e dia da semana ───────────────────
# bj_dow: 1=seg .. 7=dom. dow_utc (0=dom .. 6=sáb, escala Hinnant) vem do dia
# civil absoluto; bump soma o "dia seguinte de Pequim" quando UTC já passou de
# 16h (Pequim = UTC+8).
utc_hour=$(( now_utc / 60 ))
bump=$(( ( utc_hour + 8 ) / 24 ))                            # 0 antes das 16h UTC, 1 depois
dow_utc=$(( ( ( now_day_abs % 7 ) + 4 ) % 7 ))               # 0=dom .. 6=sáb
bj_dow=$(( ( ( ( dow_utc - 1 + bump ) % 7 + 7 ) % 7 ) + 1 )) # 1=seg .. 7=dom
bj_day_abs=$(( now_day_abs + bump ))                         # dia de Pequim absoluto

# ── Vigência da regra de fim de semana (ECO_FDS_VIGENCIA "YYYY-MM-DD", Pequim) ─
# vig_utc_min = days_from_civil(y,m,d)*1440 − 480  (00:00 Pequim = 16:00 UTC do dia anterior).
# Âncora: ECO_FDS_VIGENCIA="2026-08-23" → vig_utc_min = 29790240.
if [ -n "${ECO_FDS_VIGENCIA:-}" ]; then
  vy=$(( 10#${ECO_FDS_VIGENCIA%%-*} ))
  v_ymd="${ECO_FDS_VIGENCIA#*-}"; vm=$(( 10#${v_ymd%%-*} )); vd=$(( 10#${v_ymd##*-} ))
  vig_utc_min=$(( $(_days_from_civil "$vy" "$vm" "$vd")*1440 - 480 ))
else
  vig_utc_min=0
fi

# Offset local (ex.: -0300 → -180 min) — funciona em GNU e BSD date.
tz_raw="$(date +%z)"
tz_hh="${tz_raw:1:2}"; tz_mm="${tz_raw:3:2}"
tz_off=$(( 10#$tz_hh * 60 + 10#$tz_mm ))
case "$tz_raw" in -*) tz_off=$(( -tz_off )) ;; esac
tz_label="UTC$( [ "$tz_off" -ge 0 ] && printf '+'; printf '%d' $(( tz_off / 60 )) )"
tz_rest=$(( tz_off % 60 )); tz_rest="${tz_rest#-}"
[ "$tz_rest" -ne 0 ] && tz_label="$tz_label:$(printf '%02d' "$tz_rest")"

_local() { _hhmm "$(( ( $1 + tz_off + 2880 ) % 1440 ))"; }

# ── Picos (e os segmentos de economia entre eles) ────────────────────────────
em_pico=0
fim_pico=0                 # fim do pico atual (min UTC), se em_pico=1
prox_pico_delta=99999      # minutos até o próximo pico começar
prox_pico_ini=0
picos_loc_str=""           # horários de pico no fuso local (célula da tabela)
p_ini=(); p_fim=()
for jan in $ECO_PICOS_UTC; do
  i=$(_min "${jan%%-*}"); f=$(_min "${jan##*-}")
  p_ini+=("$i"); p_fim+=("$f")
  [ -n "$picos_loc_str" ] && picos_loc_str="$picos_loc_str e "
  picos_loc_str="$picos_loc_str$(_local "$i")-$(_local "$f")"
  # pertencimento (ciente de janela que cruza a meia-noite UTC)
  if [ "$i" -le "$f" ]; then
    if [ "$now_utc" -ge "$i" ] && [ "$now_utc" -lt "$f" ]; then em_pico=1; fim_pico=$f; fi
  else
    if [ "$now_utc" -ge "$i" ] || [ "$now_utc" -lt "$f" ]; then em_pico=1; fim_pico=$f; fi
  fi
  d=$(( ( i - now_utc + 1440 ) % 1440 ))
  if [ "$d" -lt "$prox_pico_delta" ]; then prox_pico_delta=$d; prox_pico_ini=$i; fi
done
ate_economia=$(( ( fim_pico - now_utc + 1440 ) % 1440 ))

# ── Fim de semana (regra nova): ECONOMIA o DIA TODO; picos não valem ────────
# Ativo = ECO_FDS_ECO_DIA_INTEIRO=1 E now_abs >= vig_utc_min E bj_dow ∈ {6,7}.
# "Próximo pico" nesse caso = o INÍCIO da PRIMEIRA janela de pico configurada
# (p_ini[0]) na próxima segunda de Pequim — derivado de ECO_PICOS_UTC, não
# hardcoded. Com as janelas padrão (01:00-04:00) p_ini[0]=60 → mesma saída de
# antes. Âncoras: sáb 2026-08-29 07:00Z → 42h; dom 2026-08-30 07:00Z → 18h.
fds_ativo=0
if [ "${ECO_FDS_ECO_DIA_INTEIRO:-1}" = "1" ] && [ "$now_abs" -ge "$vig_utc_min" ] \
   && { [ "$bj_dow" = "6" ] || [ "$bj_dow" = "7" ]; }; then
  fds_ativo=1
  em_pico=0
  dias_ate_seg=$(( ( 8 - bj_dow ) % 7 ))          # sáb=2, dom=1
  prox_pico_ini=${p_ini[0]}                       # início da 1ª janela de pico (UTC)
  prox_pico_delta=$(( ( bj_day_abs + dias_ate_seg )*1440 + prox_pico_ini - now_abs ))
fi

# Economia = os intervalos ENTRE os picos (fim de um → início do próximo,
# ciclicamente) — por isso o conf exige as janelas em ordem cronológica.
eco_loc_str=""
n=${#p_ini[@]}
for (( k = 0; k < n; k++ )); do
  nx=$(( (k + 1) % n ))
  [ -n "$eco_loc_str" ] && eco_loc_str="$eco_loc_str e "
  eco_loc_str="$eco_loc_str$(_local "${p_fim[k]}")-$(_local "${p_ini[nx]}")"
done

# ── Tabela de horários e valores (bordas finas, mesmo traço do banner) ──────
_rep() { printf '%*s' "$1" '' | sed 's/ /─/g'; }
_wmax() { local m=0 s; for s in "$@"; do [ "${#s}" -gt "$m" ] && m=${#s}; done; printf '%d' "$m"; }

_tabela() {
  # Células 100% ASCII: `${#s}` conta chars == bytes, e `printf %-*s` alinha por
  # bytes — então a largura da coluna é correta em QUALQUER locale. Basta manter
  # cada célula em ASCII puro (byte = char). A explicação de "fim de semana → não
  # há pico" vive na linha de status (que não é tabela e pode ter acentos).
  local m_eco="  " m_pico="  "
  if [ "$em_pico" = "1" ]; then m_pico="> "; else m_eco="> "; fi
  local r2lbl="${m_pico}pico (2x)"
  local h1="faixa"            r1c1="${m_eco}economia" r2c1="$r2lbl"
  local h2="horario ($tz_label)" r1c2="$eco_loc_str"  r2c2="$picos_loc_str"
  local h3="v4-flash (hit/miss/out)" r1c3="$ECO_PRECO_FLASH_ECONOMIA" r2c3="$ECO_PRECO_FLASH_PICO"
  local h4="v4-pro (hit/miss/out)"   r1c4="$ECO_PRECO_PRO_ECONOMIA"   r2c4="$ECO_PRECO_PRO_PICO"
  local w1 w2 w3 w4
  w1=$(_wmax "$h1" "$r1c1" "$r2c1"); w2=$(_wmax "$h2" "$r1c2" "$r2c2")
  w3=$(_wmax "$h3" "$r1c3" "$r2c3"); w4=$(_wmax "$h4" "$r1c4" "$r2c4")
  printf '┌─%s─┬─%s─┬─%s─┬─%s─┐\n' "$(_rep "$w1")" "$(_rep "$w2")" "$(_rep "$w3")" "$(_rep "$w4")"
  printf '│ %-*s │ %-*s │ %-*s │ %-*s │\n' "$w1" "$h1" "$w2" "$h2" "$w3" "$h3" "$w4" "$h4"
  printf '├─%s─┼─%s─┼─%s─┼─%s─┤\n' "$(_rep "$w1")" "$(_rep "$w2")" "$(_rep "$w3")" "$(_rep "$w4")"
  printf '│ %-*s │ %-*s │ %-*s │ %-*s │\n' "$w1" "$r1c1" "$w2" "$r1c2" "$w3" "$r1c3" "$w4" "$r1c4"
  printf '│ %-*s │ %-*s │ %-*s │ %-*s │\n' "$w1" "$r2c1" "$w2" "$r2c2" "$w3" "$r2c3" "$w4" "$r2c4"
  printf '└─%s─┴─%s─┴─%s─┴─%s─┘\n' "$(_rep "$w1")" "$(_rep "$w2")" "$(_rep "$w3")" "$(_rep "$w4")"
}

_status_curto() {
  if [ "$fds_ativo" = "1" ]; then
    pico_bj=$(( ( prox_pico_ini + 480 ) % 1440 ))                       # horário de Pequim
    pico_local=$(_local "$prox_pico_ini")
    echo "💰 deepeco: ECONOMIA o DIA TODO (fim de semana — fuso de Pequim); primeiro pico da próxima semana (segunda de Pequim): $(_hhmm "$pico_bj") Pequim (= $(_hhmm "$prox_pico_ini") UTC = $pico_local $tz_label)"
  elif [ "$em_pico" = "1" ]; then
    echo "⏰ deepeco: HORÁRIO DE PICO (preço 2×) — a economia volta às $(_local "$fim_pico") $tz_label (daqui a $(_dur "$ate_economia"))"
  else
    echo "💰 deepeco: ECONOMIA ATIVA (½ do preço de pico) — próximo pico às $(_local "$prox_pico_ini") $tz_label (daqui a $(_dur "$prox_pico_delta"))"
  fi
}

# ── Saída ────────────────────────────────────────────────────────────────────
# Paridade com `deepclaude --help` e `projects --help`: toda ferramenta da aula
# responde --help. E flag desconhecida ERRA — antes, `deepeco --helpp` caía no
# caminho normal e imprimia a tabela como se a flag existisse.
case "${1:-}" in
  -h|--help)
    cat <<EOF
deepeco — a API DeepSeek está em horário de economia ou de pico agora?

  deepeco            banner MUNDO DEV + status + tabela de horários e tarifas
  deepeco --short    só status + tabela (é o que o \`deepclaude\` imprime ao subir)
  deepeco --help     esta ajuda

Dentro de uma sessão do deepclaude: /eco

Regime (desde 16/08/2026 16:00 UTC): os picos custam 2× e todo o resto do dia
(17h) é economia — metade do preço de pico, para todos os modelos. As janelas
são definidas em UTC pelo relógio do SERVIDOR da API; este comando converte
para o SEU fuso automaticamente.

Regra de fim de semana (desde 2026-08-23 00:00 de Pequim = 2026-08-22 16:00
UTC): no sábado e no domingo do fuso de PEQUIM (UTC+8) o dia inteiro é
economia — os picos NÃO valem. Dias úteis (seg a sex, Pequim) seguem o regime
acima. Desligue com ECO_FDS_ECO_DIA_INTEIRO="0" no conf.

Janela, tarifas e vigência vivem em:
  ${CONF}
Quando a DeepSeek mudar a política, edite esse arquivo — não este script.

Ambiente:
  DEEPECO_CONF        caminho do conf (default: ~/.config/aula-dev/deepeco.conf)
  DEEPECO_NOW="YYYY-MM-DD HH:MM"  simula o relógio nesse instante (UTC) — teste
                          e preview (ex.: ver "como estará amanhã")
  MUNDO_DEV_BANNER=0  desliga o banner
EOF
    exit 0 ;;
  ""|--short) : ;;
  *)
    echo "deepeco: flag desconhecida '$1' (veja: deepeco --help)" >&2
    exit 2 ;;
esac

if [ "${1:-}" = "--short" ]; then
  if [ "$ECO_ATIVO" != "1" ]; then
    echo "💰 deepeco: sem variação de preço por horário no momento (preço fixo)."
    exit 0
  fi
  _status_curto
  _tabela
  exit 0
fi

_mundo_dev_banner
echo "Agora:   $(_local "$now_utc") $tz_label  ·  $(_hhmm "$now_utc") UTC"
if [ "$ECO_ATIVO" != "1" ]; then
  echo "Status:  ℹ️  a DeepSeek NÃO varia preço por horário no momento — preço fixo 24h."
  echo "         (Se isso mudar, atualize $CONF)"
else
  echo "Regime:  peak/off-peak — $ECO_DESCONTO_LABEL"
  _status_curto
  echo
  _tabela
  echo
  echo "⚠️  A doc oficial não define se vale o horário de INÍCIO ou de CONCLUSÃO"
  echo "    da requisição (na política de 2025 valia a conclusão) — perto da"
  echo "    fronteira do pico, dê margem nas tarefas longas."
fi
echo "Fonte: $ECO_FONTE"
